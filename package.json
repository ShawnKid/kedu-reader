{
  "name": "kedu-reader",
  "private": true,
  "version": "0.1.0",
  "description": "苛读 — 本地优先的桌面电子书阅读器（Tauri 2 + TypeScript + Rust）",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean:dist": "node scripts/clean-dist.cjs",
    "build": "tsc && node scripts/clean-dist.cjs && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
